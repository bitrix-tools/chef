#!/usr/bin/env node

// Stands in for the oxlint binary in editor integrations: `chef-oxlint --lsp` runs
// chef's language server (oxlint that understands Flow files), anything else is passed
// to oxlint unchanged.
import { spawn } from 'node:child_process';
import { createRequire } from 'node:module';
import * as path from 'node:path';
import * as tty from 'node:tty';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
const binDir = path.dirname(fileURLToPath(import.meta.url));

const LSP_HEADER = 'Content-Length:';
const LSP_WAIT_MS = 10000;

function runLanguageServer(received)
{
	const stdin = received ? 'pipe' : 'inherit';
	const child = spawn(process.execPath, [path.join(binDir, 'chef'), 'lint', '--lsp'], { stdio: [stdin, 'inherit', 'inherit'] });
	child.on('exit', (code) => process.exit(code ?? 0));

	if (received)
	{
		child.stdin.write(received);
		process.stdin.pipe(child.stdin);
	}
}

function runOxlint()
{
	const require = createRequire(import.meta.url);
	const oxlint = path.join(path.dirname(require.resolve('oxlint/package.json')), 'bin', 'oxlint');
	const child = spawn(process.execPath, [oxlint, ...args], { stdio: 'inherit' });
	child.on('exit', (code) => process.exit(code ?? 0));
}

// Oxc plugins for JetBrains IDEs before 0.0.44 start a manually set binary without `--lsp`.
// The type of stdin does not tell an editor apart: CI runners give their steps a pipe as well.
// An editor sends an LSP message right away, so the first bytes decide.
function runByFirstMessage()
{
	let received = Buffer.alloc(0);
	let decided = false;

	const decide = () => {
		if (decided)
		{
			return;
		}

		decided = true;
		clearTimeout(timer);
		process.stdin.off('data', onData);
		process.stdin.pause();

		if (received.toString('latin1').trimStart().startsWith(LSP_HEADER))
		{
			runLanguageServer(received);
		}
		else
		{
			process.stdin.destroy();
			runOxlint();
		}
	};

	const onData = (chunk) => {
		received = Buffer.concat([received, chunk]);
		if (received.toString('latin1').trimStart().length >= LSP_HEADER.length)
		{
			decide();
		}
	};

	const timer = setTimeout(decide, LSP_WAIT_MS);
	process.stdin.on('data', onData);
	process.stdin.once('end', decide);
	process.stdin.once('error', decide);
}

if (args.includes('--lsp'))
{
	runLanguageServer(null);
}
else if (args.length === 0 && !tty.isatty(0))
{
	runByFirstMessage();
}
else
{
	runOxlint();
}
